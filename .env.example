# GLPal settings. Copy this file to .env and fill in ONE AI key (or none: GLPal runs in offline mode).

# auto = use whichever key below is set, otherwise offline mode. Or force: deepseek | openai | anthropic | mock
LLM_PROVIDER=auto

# DeepSeek (cheap, text only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude (text + meal photos)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI (text + meal photos)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Live search of trusted medical websites for coach answers (Anthropic only). auto = on when the
# Anthropic provider is active; off = use only the built-in source library. ~$10 per 1,000 searches.
WEB_SEARCH=auto

PORT=8000
